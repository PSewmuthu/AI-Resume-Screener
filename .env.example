# Copy this file to .env and fill in your own free Groq API key.
# Get a free key (no credit card required) at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model.
# Default: openai/gpt-oss-120b (Groq free tier, current as of Aug 2026)
# Smaller/faster alternative with higher free rate limits: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
